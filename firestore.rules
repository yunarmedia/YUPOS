rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMerchant(merchantId) {
      return request.auth != null && request.auth.uid == merchantId;
    }

    function merchantProfileExists(merchantId) {
      return exists(/databases/$(database)/documents/merchants/$(merchantId));
    }

    function isDeveloperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'developer'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isLicensedMerchant(merchantId) {
      return isMerchant(merchantId)
        && merchantProfileExists(merchantId)
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.licenseStatus == 'active';
    }

    function merchantFieldMatches(merchantId) {
      return !('merchantId' in request.resource.data) || request.resource.data.merchantId == merchantId;
    }

    match /admins/{adminId} {
      // Avoid self-referential get() during the admin profile read.
      allow read: if request.auth != null
        && request.auth.uid == adminId
        && resource.data.role == 'developer'
        && resource.data.active == true;
      allow write: if false;
    }

    match /merchants/{merchantId} {
      allow read: if isMerchant(merchantId) || isDeveloperAdmin();

      // Spark-compatible Developer Admin management. The Authentication user
      // must be created manually in Firebase Console first; this document only
      // provisions/updates the merchant profile and license.
      allow create: if isDeveloperAdmin()
        && request.resource.data.uid == merchantId
        && request.resource.data.licenseStatus in ['active', 'suspended', 'pending'];

      allow update: if isDeveloperAdmin()
        && request.resource.data.uid == merchantId
        && resource.data.uid == merchantId
        && request.resource.data.licenseStatus in ['active', 'suspended', 'pending'];

      allow delete: if false;
    }

    match /yupos_config/{merchantId}/settings/{document} {
      allow read: if isLicensedMerchant(merchantId);
      allow create, update: if isLicensedMerchant(merchantId) && merchantFieldMatches(merchantId);
      allow delete: if isLicensedMerchant(merchantId);
    }

    match /yupos_catalog/{merchantId}/{businessType}/{document} {
      allow read: if isLicensedMerchant(merchantId);
      allow create, update: if isLicensedMerchant(merchantId) && merchantFieldMatches(merchantId);
      allow delete: if isLicensedMerchant(merchantId);
    }

    match /yupos_transactions/{merchantId}/{businessType}/{document} {
      allow read: if isLicensedMerchant(merchantId);
      allow create, update: if isLicensedMerchant(merchantId) && merchantFieldMatches(merchantId);
      allow delete: if isLicensedMerchant(merchantId);
    }

    match /yupos_finances/{merchantId}/{businessType}/{document} {
      allow read: if isLicensedMerchant(merchantId);
      allow create, update: if isLicensedMerchant(merchantId) && merchantFieldMatches(merchantId);
      allow delete: if isLicensedMerchant(merchantId);
    }

    match /yupos_crm/{merchantId}/customers/{document} {
      allow read: if isLicensedMerchant(merchantId);
      allow create, update: if isLicensedMerchant(merchantId) && merchantFieldMatches(merchantId);
      allow delete: if isLicensedMerchant(merchantId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
